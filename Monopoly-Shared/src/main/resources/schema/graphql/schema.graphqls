enum GameState {
    STARTED
    IN_PROGRESS
    FINISHED
}

enum PlayerColors {
    PLAYER_RED,
    PLAYER_BLUE,
    PLAYER_YELLOW,
    PLAYER_GREEN
}

enum PropertyNames{
    BROWN_1,BROWN_2,
    LIGHTBLUE_1,LIGHTBLUE_2,LIGHTBLUE_3,
    PINK_1,PINK_2,PINK_3,
    ORANGE_1,ORANGE_2,ORANGE_3,
    RED_1,RED_2,RED_3,
    YELLOW_1,YELLOW_2,YELLOW_3,
    GREEN_1,GREEN_2,GREEN_3,
    BLUE_1,BLUE_2
}

type GameDTO {
    gameId: ID
    players: [PlayerDTO]
    currentPlayerIndex:Int
    gameState: GameState
    createdTime: String
}

type PlayerDTO {
    playerId: ID
    playerName: String
    color: PlayerColors
    balance: Int
    position: Int
    ownedProperties: [PropertyDTO]
    inJail:Boolean
}

type PropertyDTO{
    propertyName:PropertyNames
    cost: Int
    rent:Int
    upgradable: Boolean
}


