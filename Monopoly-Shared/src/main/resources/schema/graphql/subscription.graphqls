type Subscription {
    gameUpdated(gameId:ID!):GameDTO!
    diceUpdated(gameId:ID!):DicePosition!
}

type DicePosition{
    gameId: ID!,
    pos:Vector3,
    rot:Quaternion
}
type Vector3{
    x:Float,
    y:Float,
    z:Float
}

type Quaternion{
    x:Float,
    y:Float,
    z:Float,
    w:Float
}