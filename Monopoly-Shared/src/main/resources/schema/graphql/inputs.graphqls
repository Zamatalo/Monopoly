input GameDTOInput {
    gameId: ID
    gameState: GameState!
    players: [PlayerDTOInput]!
    currentPlayerIndex: Int!
}

input PlayerDTOInput {
    playerId: ID
    color: String
    balance: Int
    position:Int
    inJail:Boolean
    ownedProperties:[PropertiesDTOInput]
}

input PropertiesDTOInput{
    propertyName:PropertyNames
    cost:Int
    rent:Int
    upgradable:Boolean
}