input GameDTO {
    gameId: ID
    gameState: GameState!
    players: [PlayerDTO]!
    currentPlayerIndex: Int!
}

input PlayerDTO {
    playerId: ID
    color: String
    balance: Int
    position:Int
    inJail:Boolean
    ownedProperties:[PropertiesDTO]
}

input PropertiesDTO{
    propertyName:PropertyNames
    cost:Int
    rent:Int
    upgradable:Boolean
}