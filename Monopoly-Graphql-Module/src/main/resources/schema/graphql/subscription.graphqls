type Subscription {
    gameUpdated(gameId:ID!):GameDTO!
    diceUpdated(gameId:ID!):DicePosition!
}

type DicePosition{
    gameId: ID!,
    pos_dice1:Vector3!,
    rot_dice1:Quaternion!
    pos_dice2:Vector3!,
    rot_dice2:Quaternion!
}
type Vector3{
    x:Float,
    y:Float,
    z:Float
}

type Quaternion{
    x:Float,
    y:Float,
    z:Float,
    w:Float
}