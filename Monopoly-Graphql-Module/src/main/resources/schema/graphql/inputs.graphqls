input GameDTOInput {
    gameId: ID
    gameState: GameState!
    players: [PlayerDTOInput]!
    currentPlayerIndex: Int!
    createdTime:String!
}



input PlayerDTOInput {
    playerId: ID
    playerName:String
    color: String
    balance: Int
    position:Int
    inJail:Boolean
    ownedProperties:[PropertiesDTOInput]
}

input PropertiesDTOInput{
    displayName:String
    boardPosition:Int
    cost:Int
    upgradable:Boolean
}